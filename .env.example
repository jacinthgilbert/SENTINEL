# Free, self-service key: https://portal.opentopography.org -> My Account
# Limit: 200 calls/24h (academic) or 50/24h. We use exactly ONE.
OPENTOPO_API_KEY=your_key_here
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel

# ── Real outbound SMS (Step 13) ──────────────────────────────────────────
# Never commit the real .env. Verify delivery before demo day:
#     make sms-test TO=+91XXXXXXXXXX
# Twilio will ACCEPT messages to Indian numbers and the carrier may silently
# drop them without DLT registration under TRAI. Check delivery, not the send.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Android phone as SMS gateway (free, uses your own SIM) ───────────────
# Install an SMS gateway app with a local-server mode, start it, and copy the
# address it shows. Both devices must be on the same network — prefer the
# phone's hotspot, since venue wifi usually blocks device-to-device traffic.
ANDROID_SMS_URL=
ANDROID_SMS_USER=
ANDROID_SMS_PASS=
